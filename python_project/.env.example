# ==============================================================================
# Daily Playwright QA Job Scraper & Google Sheets Updater - Environment Config
# Candidate: Akash Kollabathula (SDET | Playwright + TypeScript Automation)
# ==============================================================================

# 1. Google Sheets Configuration
# The ID from your Google Sheets URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID="your_google_spreadsheet_id_here"
WORKSHEET_NAME="Sheet1"

# 2. Google Service Account Credentials
# Option A: Paste the entire content of service-account-key.json as a single-line JSON string (Best for GitHub Actions Secrets)
GOOGLE_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...gserviceaccount.com"}'

# Option B: Local file path to service account credentials JSON (Best for local VS Code testing)
GOOGLE_APPLICATION_CREDENTIALS="service_account_credentials.json"

# 3. Job Search API Key (RapidAPI / JSearch / Google Jobs)
# Sign up free at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY="your_rapidapi_key_here"
RAPIDAPI_HOST="jsearch.p.rapidapi.com"

# 4. Optional Filters & Overrides
# MINIMUM_MATCH_SCORE=90
# POSTING_WINDOW_HOURS=24
